# Copy this file to .env and fill in real values. Never commit .env.

# Postgres. Local: `docker run -d --name ba-pg -e POSTGRES_PASSWORD=localdev
#   -e POSTGRES_DB=budget_dev -p 127.0.0.1:5433:5432 postgres:16-alpine`
# Neon/hosted: DATABASE_URL = POOLED string (host contains "-pooler"),
#   DIRECT_URL = the non-pooled string (used by `prisma migrate`). Both need
#   ?sslmode=require. Locally they are the same.
DATABASE_URL="postgresql://postgres:localdev@127.0.0.1:5433/budget_dev"
DIRECT_URL="postgresql://postgres:localdev@127.0.0.1:5433/budget_dev"

# Integration tests only: an EMPTY-able database; each test run creates and
# drops its own schema inside it, so it never touches your dev data.
TEST_DATABASE_URL="postgresql://postgres:localdev@127.0.0.1:5433/budget_test"

# 32-byte key (base64) used for AES-256-GCM encryption of Plaid access tokens.
# Generate your own with: openssl rand -base64 32
ENCRYPTION_KEY=

# Feature flag: live bank/card linking via Plaid. Defaults to false — CSV/OFX
# import is the default, fully-functional path with no external dependency.
ENABLE_PLAID=false

# Plaid sandbox credentials (only required when ENABLE_PLAID=true).
# NEVER use production Plaid keys in this project.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Only for banks that use OAuth (Bank of America, Chase, …). Your site's /plaid-oauth URL,
# also allow-listed in the Plaid dashboard. Leave blank in sandbox / local dev.
PLAID_REDIRECT_URI=

# Secret for the daily Plaid refresh (Vercel Cron sends it as "Authorization: Bearer <value>").
# At least 16 characters; generate with: openssl rand -base64 24
CRON_SECRET=

# Secret used to sign login session tokens (HMAC-SHA256). Required: the server
# refuses authenticated requests without it. Generate your own with:
#   openssl rand -base64 32
# Changing it signs every user out.
AUTH_SECRET=

# Email (verification links). Gmail example: turn on 2-Step Verification, then
# create an App Password at https://myaccount.google.com/apppasswords and use
# it as SMTP_PASS (never your normal password). Leave SMTP_* empty in local dev
# to just log the verification link to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Public base URL used in email links (no trailing slash). Required in production.
APP_URL=

# Contact mailbox shown on the /privacy and /terms pages (baked in at build time).
NEXT_PUBLIC_CONTACT_EMAIL=
