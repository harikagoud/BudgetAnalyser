    "eslint-config-prettier": "^10.1.8",
    "pdf-lib": "^1.17.1",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
