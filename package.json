    "@radix-ui/react-select": "^2.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.53.0",
    "next": "14.2.35",
    "nodemailer": "^10.1.1",
    "ofx-js": "^1.1.2",
    "pino": "^10.4.0",
    "plaid": "^48.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-plaid-link": "^5.0.0",
