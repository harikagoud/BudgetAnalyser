// Prisma schema for Budget Analyser Core.
// See specs/001-budget-analyser-core/data-model.md for the authoritative
// field-by-field design this file implements.
//
// Notes:
// - Fields that are conceptually enums (Account.type, Transaction.categorySource,
//   MerchantRule.source, ImportBatch.format) are modeled as `String` and
//   validated with Zod at the application boundary (see lib/validation + T032).
// - Monetary `amount` fields use `Float` (double precision). All aggregation
//   code rounds to 2 decimal places to avoid floating-point drift
//   (see lib/aggregation).
// - DATABASE_URL is the (pooled) runtime connection; DIRECT_URL is the
//   non-pooled connection Prisma Migrate uses (Neon needs both).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A person who signs in. Every Account (and therefore every Transaction,
/// ImportBatch) hangs off exactly one User; USER merchant rules and
/// UserSettings are per-user too. SEED rules/Categories stay global.
model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lowercased
  passwordHash    String // scrypt$N$r$p$salt$hash — never plaintext, never logged
  emailVerifiedAt DateTime? // null until the emailed link is clicked; login is refused while null
  createdAt       DateTime  @default(now())

  accounts      Account[]
  settings      UserSetting[]
  merchantRules MerchantRule[]
  budgetLimits  BudgetLimit[]
}

/// How transactions enter the system for a given Account.
/// Allowed values: "MANUAL" | "PLAID"
model Account {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  type                 String // MANUAL | PLAID
  plaidItemId          String?
  accessTokenEncrypted String? // AES-256-GCM ciphertext; never plaintext, never logged
  institutionName      String?
  createdAt            DateTime  @default(now())
  lastSyncedAt         DateTime?

  transactions  Transaction[]
  importBatches ImportBatch[]

  @@index([userId])
}

/// How a transaction's category was assigned.
/// Allowed values: "RULE" | "USER_OVERRIDE" | "DEFAULT"
model Transaction {
  id                 String       @id @default(cuid())
  accountId          String
  account            Account      @relation(fields: [accountId], references: [id])
  date               DateTime
  amount             Float // positive = expense, negative = refund/credit
  merchantRaw        String
  merchantNormalized String
  categoryId         String
  category           Category     @relation(fields: [categoryId], references: [id])
  categorySource     String // RULE | USER_OVERRIDE | DEFAULT
  dedupeKey          String       @unique
  importBatchId      String?
  importBatch        ImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt          DateTime     @default(now())

  @@index([accountId, date])
  @@index([categoryId])
}

model Category {
  id                  String  @id @default(cuid())
  name                String  @unique
  isDiscretionary     Boolean
  isDefault           Boolean @default(false)
  /// True for money movements that are not spending (card payments, transfers):
  /// their transactions are kept but left out of every spend total.
  excludeFromSpending Boolean @default(false)

  transactions  Transaction[]
  merchantRules MerchantRule[]
  budgetLimits  BudgetLimit[]
}

/// Source of a merchant->category mapping.
/// Allowed values: "SEED" | "USER"
/// SEED rules are global (userId = null); USER rules belong to one user.
/// Uniqueness of (pattern, source, userId) is enforced in application code
/// (SQL treats NULLs as distinct in unique indexes), see
/// lib/db/seed-defaults.ts and lib/categorization/engine.ts upsertUserRule.
model MerchantRule {
  id         String   @id @default(cuid())
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  source     String // SEED | USER
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([pattern, source, userId])
}

model UserSetting {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@id([userId, key])
}

/// Statement file format for a given ImportBatch.
/// Allowed values: "CSV" | "OFX"
model ImportBatch {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  fileName         String
  format           String // CSV | OFX
  transactionCount Int
  duplicateCount   Int
  errorCount       Int
  createdAt        DateTime @default(now())

  transactions Transaction[]
}

/// A user's monthly spending limit for one category (applies to every month).
/// Removed with the user (cascade); Categories are global and never deleted.
model BudgetLimit {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Float // dollars per month, > 0, stored to the cent
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([userId, categoryId])
}
